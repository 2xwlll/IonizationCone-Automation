# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# =========================
# Virtual environments
# =========================
venv/
.env/
.envrc/
.venv/

# =========================
# Jupyter notebooks
# =========================
.ipynb_checkpoints/

# =========================
# OS / editor junk
# =========================
.DS_Store
*.swp
*.swo
*.tmp
nvim.log

# =========================
# Data (keep local only)
# =========================
data/
!data/.gitkeep

# =========================
# Model checkpoints / weights
# =========================
*.pth
*.pt
*.ckpt

# =========================
# Experiment outputs / results (regenerate or transfer separately)
# =========================
/results/
/saved_runs/

# Keep the authored LaTeX source, not compiled documents or render previews.
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/*.tex

# =========================
# Logs
# =========================
*.log

# =========================
# Archive / legacy code
# =========================
archive/

